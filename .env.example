# IMGWTools configuration (Nogat DEV-18). Copy this file to .env and adjust values.
#
# A setting comes from the first of: the command-line option, the variable
# IMGW_<KEY> in the environment, the same variable in .env, NOGAT_<KEY> (only
# data_dir, cache_dir and lang), the section [imgw] and then [nogat] of
# nogat.toml (key = the variable without IMGW_, lower case), the default.
# nogat.toml lives in the user configuration directory (for example
# ~/.config/nogat/nogat.toml) or at the path in NOGAT_CONFIG. Credentials
# (IMGW_STORE_WRITE_TOKEN) are read from the environment only, never from
# nogat.toml. `imgw config show --json` lists every value and where it comes from.

# --- Shared with the other tools (also NOGAT_DATA_DIR, NOGAT_CACHE_DIR, NOGAT_LANG)
# Parent directory of the stores (<data_dir>/imgw) and of the server state.
# Default: the user data directory of nogat (for example ~/.local/share/nogat).
# Until 3.0.0 this variable held the reference data: that is IMGW_REFERENCE_DIR now.
# IMGW_DATA_DIR=
# Caches (<cache_dir>/imgw). Default: the user cache directory of nogat.
# IMGW_CACHE_DIR=
# Language of the human-readable output of the CLI (help, progress and notice lines):
# pl or en. Machine output (--json, AGENTS.md, the MCP server) stays English.
IMGW_LANG=pl

# --- Reference data of IMGW-PIB (python -m imgwtools.reference_data)
# Default: <cache_dir>/imgw/reference
# IMGW_REFERENCE_DIR=

# --- REST server (imgw server)
# Environment: development, production
IMGW_ENV=development
IMGW_HOST=0.0.0.0
IMGW_PORT=8000
# Logging level: DEBUG, INFO, WARNING, ERROR
IMGW_LOG_LEVEL=INFO
# File of the API keys of `imgw admin` (default: <data_dir>/imgw/api_keys.json)
# IMGW_API_KEYS_FILE=
# Rate limiting (requests per hour per key, 0 = unlimited)
IMGW_RATE_LIMIT=100
# Default and maximum page size of REST list commands
IMGW_API_MAX_LIMIT=1000

# --- Store root (DEV-19.2): the default of --root for the CLI, the library and `imgw mcp`
# (else <data_dir>/imgw), and the only store of the REST server
# IMGW_ROOT=/srv/imgw
IMGW_STORE_WRITES_ENABLED=false
# Credential: token of REST writes (header X-API-Key); environment only
# IMGW_STORE_WRITE_TOKEN=
# Directory of user station-location CSVs offered to the REST routes by file name
# IMGW_USER_LOCATIONS_DIR=

# --- MCP (extra imgwtools[mcp])
# Serve MCP over Streamable HTTP at /mcp in `imgw server` (read and plan only)
IMGW_MCP_ENABLED=false
# Host names answered by /mcp (comma-separated, with or without a port)
IMGW_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Start `imgw mcp` in the write mode (writing tools still plan unless check=false)
IMGW_MCP_ALLOW_WRITES=false
