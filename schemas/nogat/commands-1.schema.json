{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Nogat/schemas/agent/commands-1.schema.json",
  "title": "<tool>-commands/1",
  "description": "Command catalog (AGI §2). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": ["schema", "tool", "version", "commands"],
  "properties": {
    "schema": {"type": "string", "pattern": "^[a-z][a-z0-9]*-commands/1$"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "version": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}}
  },
  "$defs": {
    "command_name": {
      "description": "`<group> <verb>` as typed in the CLI",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]* [a-z][a-z0-9-]*$"
    },
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "command": {
      "type": "object",
      "required": [
        "name", "operation_id", "function", "summary", "description", "options",
        "result", "effects", "check", "rules", "examples", "errors", "i18n"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/command_name"},
        "operation_id": {
          "description": "`<tool>_<group>_<verb>`; MCP tool name and OpenAPI operationId (AGI-5.2)",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9]+_[a-z0-9_]+$",
          "maxLength": 48
        },
        "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
        "summary": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "result": {
          "type": "object",
          "required": ["schema", "cardinality"],
          "properties": {
            "schema": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]+/[1-9][0-9]*$"},
            "cardinality": {"enum": ["single", "bounded", "unbounded"]}
          }
        },
        "effects": {
          "type": "object",
          "required": ["read_only", "writes", "idempotent", "network", "destructive"],
          "properties": {
            "read_only": {"type": "boolean"},
            "writes": {"enum": ["none", "add", "replace", "delete"]},
            "idempotent": {"type": "boolean"},
            "network": {"type": "boolean"},
            "destructive": {"type": "boolean"}
          },
          "if": {"properties": {"read_only": {"const": true}}},
          "then": {"properties": {"writes": {"const": "none"}, "destructive": {"const": false}}}
        },
        "check": {
          "description": "name of the command that plans this one without effects, or null",
          "oneOf": [{"$ref": "#/$defs/command_name"}, {"type": "null"}]
        },
        "families": {
          "description": "MCP tool families selectable with --tools (AGI-5.8); `core` marks the core family (AGI-5.12)",
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["call", "result"],
            "properties": {
              "call": {"type": "string", "minLength": 1, "description": "complete CLI call"},
              "result": {"description": "excerpt of the expected result"}
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {"$ref": "error-1.schema.json#/$defs/code"},
          "uniqueItems": true
        },
        "i18n": {
          "type": "object",
          "required": ["pl"],
          "properties": {
            "pl": {
              "type": "object",
              "properties": {
                "summary": {"type": "string"},
                "description": {"type": "string"},
                "rules": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
        "unit": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "meaning"],
            "properties": {"value": {}, "meaning": {"type": "string", "minLength": 1}}
          }
        },
        "min": {"type": "number"},
        "max": {"type": "number"},
        "pattern": {"type": "string"},
        "examples": {"type": "array"},
        "description": {"type": "string", "minLength": 1},
        "one_of": {"$ref": "#/$defs/identifier", "description": "mutual exclusion group"},
        "path_role": {"enum": ["input", "output", "root"]}
      }
    }
  }
}
