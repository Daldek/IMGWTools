{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Nogat/schemas/agent/error-1.schema.json",
  "title": "<tool>-error/1",
  "description": "Error document (AGI-4.3, ERR-4). Generated from standards/error_registry.json by `uv run scripts/ecosystem.py standard --write`; do not edit. Unknown fields are allowed (AGI-4.1).",
  "type": "object",
  "required": [
    "schema",
    "code",
    "title",
    "message",
    "details",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*-error/1$"
    },
    "code": {
      "$ref": "#/$defs/code"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "hint": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "command": {
      "$ref": "commands-1.schema.json#/$defs/command_name"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "internal_error"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "validation_error"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "not_found"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "conflict"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "source_unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "missing_dependency"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "data_error"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 7
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "store_unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 8
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "io_error"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 9
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "forbidden"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 12
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "calculation_error"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 13
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "no_data"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 14
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 15
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 130
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "terminated"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 143
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "unauthorized"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "method_not_allowed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "rate_limited"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": null
          }
        }
      }
    }
  ],
  "$defs": {
    "code": {
      "enum": [
        "internal_error",
        "validation_error",
        "not_found",
        "conflict",
        "source_unavailable",
        "missing_dependency",
        "data_error",
        "store_unavailable",
        "io_error",
        "forbidden",
        "calculation_error",
        "no_data",
        "unsupported",
        "cancelled",
        "terminated",
        "unauthorized",
        "method_not_allowed",
        "rate_limited"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
